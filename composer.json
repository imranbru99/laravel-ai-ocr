{
    "name": "imrandevbd/laravel-ai-ocr",
    "description": "Private manual-first document extraction with local OCR, quality scoring and targeted AI Hub fallback for Laravel.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://imrandev.bd",
    "authors": [
        {
            "name": "Imran Ahmed",
            "email": "me@imrandev.bd",
            "homepage": "https://imrandev.bd"
        }
    ],
    "keywords": [
        "laravel",
        "ocr",
        "pdf",
        "ai",
        "llm",
        "invoice",
        "document-extraction",
        "tesseract",
        "gemini",
        "openai",
        "claude",
        "bangla"
    ],
    "require": {
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "illuminate/support": "^10|^11|^12|^13",
        "illuminate/validation": "^10|^11|^12|^13",
        "imrandevbd/laravel-ai-hub": "^1.6",
        "php": "^8.2",
        "psr/http-message": "^1|^2",
        "symfony/process": "^6.2|^7|^8"
    },
    "require-dev": {
        "larastan/larastan": "^2.9|^3",
        "laravel/pint": "^1",
        "orchestra/testbench": "^8|^9|^10|^11",
        "phpstan/phpstan": "^1.12|^2",
        "phpunit/phpunit": "^10|^11|^12|^13"
    },
    "suggest": {
        "smalot/pdfparser": "Alternative PDF text extraction",
        "phpoffice/phpspreadsheet": "Legacy XLS support",
        "phpoffice/phpword": "Additional Word formats",
        "ext-imagick": "Image preprocessing, HEIC and TIFF rasterization",
        "ext-gd": "Image resizing and preprocessing",
        "filament/filament": "Optional Filament integration"
    },
    "autoload": {
        "psr-4": {
            "ImranDevBd\\AiOcr\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "ImranDevBd\\AiOcr\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ImranDevBd\\AiOcr\\AiOcrServiceProvider"
            ],
            "aliases": {
                "AiOcr": "ImranDevBd\\AiOcr\\Facades\\AiOcr"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint",
        "analyse": "phpstan analyse --debug --memory-limit=1G",
        "check": [
            "@test",
            "pint --test",
            "@analyse"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true
}
